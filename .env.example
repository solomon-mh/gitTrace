# Copy this file to .env.local and fill in your token.
#
# GITHUB_TOKEN: a GitHub Personal Access Token used for all server-side API calls.
# It is read only in Route Handlers (server) and never exposed to the browser.
#
# Classic PAT scopes:
#   repo        (read access to private repos; omit if you only need public data)
#   read:org    (list an organization's repositories)
#
# Fine-grained PAT: grant the target org/repos "Contents: Read-only",
# "Metadata: Read-only", "Pull requests: Read-only", "Issues: Read-only".
GITHUB_TOKEN=ghp_your_token_here

# Optional: default org to load when the dashboard opens.
NEXT_PUBLIC_DEFAULT_ORG=
